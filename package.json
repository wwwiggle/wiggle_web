{
  "name": "wiggle-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "npm run build && node --import ./tests/harness/register.mjs --test \"tests/*.test.mjs\"",
    "test:postgres": "npm run build && node scripts/test-postgres.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:local:init": "node --import ./tests/harness/register.mjs scripts/init-local-db.mjs",
    "check:browser": "node scripts/browser-check.mjs",
    "check:deployed": "node --import ./tests/harness/register.mjs scripts/check-deployed.mjs",
    "test:adapters": "node --test tests/turso-adapters.test.mjs tests/google-auth.test.mjs tests/save-split.test.mjs",
    "test:integration": "node --import ./tests/harness/register.mjs --test tests/classroom-entry-flow.test.mjs tests/student-join-atomic.test.mjs tests/student-profile-management.test.mjs tests/nickname-spacing.test.mjs tests/feedback-20260809.test.mjs",
    "predev": "node scripts/prepare-pdf-assets.mjs",
    "prebuild": "node scripts/prepare-pdf-assets.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@pdf-lib/fontkit": "^1.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "aws4fetch": "^1.0.20",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.43.0",
    "next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "postgres": "3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-moveable": "0.56.0",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  }
}

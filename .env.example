OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
WIGGLE_SUBSCRIPTIONS_ENABLED=false

# 실행 환경: 로컬은 아래 값을 사용한다. Vercel에서는 VERCEL_ENV가 Preview/Production을 결정한다.
WIGGLE_APP_ENV=local
WIGGLE_DATA_ENV=local

# 로컬에서는 원격 Turso/R2 값을 비워 둔다. Preview/Production 값은 Vercel의 각 환경 범위에 따로 등록한다.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Supabase Postgres(2026-10-31 이사 중). 값이 있으면 Turso 대신 이것을 쓴다. 운영·Preview는 Supabase 연결 풀러(트랜잭션 모드, 6543) 주소.
# 로컬에서는 localhost Postgres만 허용한다(원격 주소는 막힌다). 비워 두면 지금처럼 Turso(로컬 파일)를 쓴다.
DATABASE_URL=
R2_S3_ENDPOINT=
R2_S3_BUCKET=
R2_S3_ACCESS_KEY_ID=
R2_S3_SECRET_ACCESS_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 그림책 전체 피드백 — 키가 없으면 요청을 보관합니다.
BOOK_FEEDBACK_MODEL=gpt-5.6-sol

# 스위트북: Sandbox 파트너 키를 직접 입력하세요.
SWEETBOOK_API_KEY=
SWEETBOOK_ENV=sandbox
# 실제 운영에서 Live 키로 테스트를 마친 뒤에만 true
SWEETBOOK_LIVE_ORDERS_ENABLED=false

# 운영 관리자 Google 이메일 (쉼표로 여러 명 지정, 빈 값은 모두 거부)
ADMIN_EMAILS=qudcks1940@gmail.com
# Vercel 함수 할당량을 자동 감지하지 못할 때만 실제 설정값(MB)을 지정
# ADMIN_FUNCTION_MEMORY_MB=2048
